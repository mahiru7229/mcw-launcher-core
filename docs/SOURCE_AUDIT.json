{
  "version": "1.5.0",
  "distribution": "mcw-core",
  "public_import_boundary": [
    "mcw_core",
    "mcw_core.api.*"
  ],
  "implementation_packages": [
    "src.core.*",
    "src.models.*"
  ],
  "excluded": [
    "src.gui.*",
    "PySide6",
    "accounts",
    "config/private",
    "cache",
    "instances",
    "logs",
    "runtimes"
  ],
  "bundled_resources": [
    "mcw_core/resources/mcw-lan-agent.jar",
    "mcw-curseforge-gateway-main.zip"
  ],
  "gateway_contains_secrets": false
}
